{
  "components" : {
    "schemas" : {
      "CurrentAccount" : {
        "properties" : {
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "username" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "password" : {
            "type" : "string"
          },
          "rememberMe" : {
            "description" : "Whether the browser keeps the session cookie after it is closed; false if absent",
            "type" : "boolean"
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "password", "username" ],
        "type" : "object"
      },
      "PasswordChangeRequest" : {
        "properties" : {
          "currentPassword" : {
            "type" : "string"
          },
          "newPassword" : {
            "description" : "12 to 128 characters",
            "type" : "string"
          }
        },
        "required" : [ "currentPassword", "newPassword" ],
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "SetupRequest" : {
        "properties" : {
          "password" : {
            "description" : "12 to 128 characters",
            "type" : "string"
          },
          "username" : {
            "description" : "1 to 64 characters; surrounding whitespace is removed",
            "type" : "string"
          }
        },
        "required" : [ "password", "username" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "Wardroom API",
    "version" : "1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Logged in"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Username or password is wrong"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many failed logins; the Retry-After header has the waiting time in seconds"
          }
        },
        "summary" : "Logs in",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "The session has ended"
          }
        },
        "summary" : "Logs out",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "operationId" : "getCurrentAccount",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentAccount"
                }
              }
            },
            "description" : "The logged-in account"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Not logged in"
          }
        },
        "summary" : "Returns the logged-in account",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/auth/password" : {
      "put" : {
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordChangeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Password changed and logged out"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The current password is wrong or the new one breaks a rule"
          }
        },
        "summary" : "Changes the password and ends all sessions, including the current one",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/auth/setup" : {
      "get" : {
        "operationId" : "getSetup",
        "responses" : {
          "200" : {
            "description" : "No account exists yet; setup is available"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "An account exists"
          }
        },
        "summary" : "Tells whether setup is available",
        "tags" : [ "Authentication" ]
      },
      "post" : {
        "operationId" : "setup",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Account created and logged in"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Username or password breaks a rule"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "An account exists"
          }
        },
        "summary" : "Creates the account and logs in",
        "tags" : [ "Authentication" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
