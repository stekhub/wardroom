{
  "components" : {
    "schemas" : {
      "ConnectionTestFailure" : {
        "properties" : {
          "message" : {
            "description" : "Names the cause; never contains credentials",
            "type" : "string"
          },
          "type" : {
            "enum" : [ "UNREACHABLE", "TIMEOUT", "TLS_CERTIFICATE", "TLS_HANDSHAKE", "AUTH_FAILED", "SERVER_REFUSED", "PROTOCOL" ],
            "type" : "string"
          }
        },
        "required" : [ "message", "type" ],
        "type" : "object"
      },
      "ConnectionTestRequest" : {
        "properties" : {
          "authMethod" : {
            "enum" : [ "NONE", "USER_PASS" ],
            "type" : "string"
          },
          "host" : {
            "type" : "string"
          },
          "id" : {
            "description" : "The stored server whose password is used when the password is empty or absent",
            "format" : "int64",
            "type" : "integer"
          },
          "maxConnections" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "password" : {
            "type" : "string"
          },
          "port" : {
            "format" : "int32",
            "type" : "integer"
          },
          "tlsMode" : {
            "enum" : [ "IMPLICIT", "NONE" ],
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "authMethod", "host", "maxConnections", "name", "port", "tlsMode" ],
        "type" : "object"
      },
      "ConnectionTestResult" : {
        "properties" : {
          "failure" : {
            "$ref" : "#/components/schemas/ConnectionTestFailure",
            "description" : "null on success"
          },
          "postingAllowed" : {
            "description" : "Whether the server offers posting; null when the test failed",
            "type" : "boolean"
          },
          "success" : {
            "type" : "boolean"
          }
        },
        "required" : [ "success" ],
        "type" : "object"
      },
      "CurrentAccount" : {
        "properties" : {
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "username" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "password" : {
            "type" : "string"
          },
          "rememberMe" : {
            "description" : "Whether the browser keeps the session cookie after it is closed; false if absent",
            "type" : "boolean"
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "password", "username" ],
        "type" : "object"
      },
      "PasswordChangeRequest" : {
        "properties" : {
          "currentPassword" : {
            "type" : "string"
          },
          "newPassword" : {
            "description" : "12 to 128 characters",
            "type" : "string"
          }
        },
        "required" : [ "currentPassword", "newPassword" ],
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "SavedServer" : {
        "properties" : {
          "connectionTest" : {
            "$ref" : "#/components/schemas/ConnectionTestResult",
            "description" : "The server is saved also when this test failed"
          },
          "server" : {
            "$ref" : "#/components/schemas/Server"
          }
        },
        "required" : [ "connectionTest", "server" ],
        "type" : "object"
      },
      "Server" : {
        "properties" : {
          "authMethod" : {
            "enum" : [ "NONE", "USER_PASS" ],
            "type" : "string"
          },
          "credentialsInvalid" : {
            "description" : "The server rejected the stored credentials, or the stored password can no longer be read; the owner has to enter them again",
            "type" : "boolean"
          },
          "host" : {
            "type" : "string"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "maxConnections" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "passwordStored" : {
            "description" : "Whether a password is stored; the password itself is never returned",
            "type" : "boolean"
          },
          "port" : {
            "format" : "int32",
            "type" : "integer"
          },
          "tlsMode" : {
            "enum" : [ "IMPLICIT", "NONE" ],
            "type" : "string"
          },
          "username" : {
            "description" : "null unless the authentication is USER_PASS",
            "type" : "string"
          }
        },
        "required" : [ "authMethod", "credentialsInvalid", "host", "id", "maxConnections", "name", "passwordStored", "port", "tlsMode" ],
        "type" : "object"
      },
      "ServerRequest" : {
        "properties" : {
          "authMethod" : {
            "description" : "USER_PASS needs the TLS mode IMPLICIT",
            "enum" : [ "NONE", "USER_PASS" ],
            "type" : "string"
          },
          "host" : {
            "description" : "Host name or IP address, 1 to 253 characters",
            "type" : "string"
          },
          "maxConnections" : {
            "description" : "1 to 50",
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "description" : "1 to 64 characters; surrounding whitespace is removed",
            "type" : "string"
          },
          "password" : {
            "description" : "1 to 255 characters. Needed for USER_PASS when no password is stored; empty or absent keeps the stored one",
            "type" : "string"
          },
          "port" : {
            "description" : "1 to 65535",
            "format" : "int32",
            "type" : "integer"
          },
          "tlsMode" : {
            "enum" : [ "IMPLICIT", "NONE" ],
            "type" : "string"
          },
          "username" : {
            "description" : "Needed for USER_PASS, 1 to 255 characters",
            "type" : "string"
          }
        },
        "required" : [ "authMethod", "host", "maxConnections", "name", "port", "tlsMode" ],
        "type" : "object"
      },
      "SetupRequest" : {
        "properties" : {
          "password" : {
            "description" : "12 to 128 characters",
            "type" : "string"
          },
          "username" : {
            "description" : "1 to 64 characters; surrounding whitespace is removed",
            "type" : "string"
          }
        },
        "required" : [ "password", "username" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "Wardroom API",
    "version" : "1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Logged in"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Username or password is wrong"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many failed logins; the Retry-After header has the waiting time in seconds"
          }
        },
        "summary" : "Logs in",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "The session has ended"
          }
        },
        "summary" : "Logs out",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "operationId" : "getCurrentAccount",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentAccount"
                }
              }
            },
            "description" : "The logged-in account"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Not logged in"
          }
        },
        "summary" : "Returns the logged-in account",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/auth/password" : {
      "put" : {
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordChangeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Password changed and logged out"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The current password is wrong or the new one breaks a rule"
          }
        },
        "summary" : "Changes the password and ends all sessions, including the current one",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/auth/setup" : {
      "get" : {
        "operationId" : "getSetup",
        "responses" : {
          "200" : {
            "description" : "No account exists yet; setup is available"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "An account exists"
          }
        },
        "summary" : "Tells whether setup is available",
        "tags" : [ "Authentication" ]
      },
      "post" : {
        "operationId" : "setup",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Account created and logged in"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Username or password breaks a rule"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "An account exists"
          }
        },
        "summary" : "Creates the account and logs in",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/servers" : {
      "get" : {
        "operationId" : "listServers",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/Server"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "The configured servers"
          }
        },
        "summary" : "Lists the servers: none or one",
        "tags" : [ "Servers" ]
      },
      "post" : {
        "operationId" : "createServer",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ServerRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SavedServer"
                }
              }
            },
            "description" : "Saved, also when the connection test failed"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "A field breaks a rule"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "A server already exists"
          }
        },
        "summary" : "Adds the server and tests the connection",
        "tags" : [ "Servers" ]
      }
    },
    "/api/servers/connection-test" : {
      "post" : {
        "operationId" : "testServerConnection",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ConnectionTestRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConnectionTestResult"
                }
              }
            },
            "description" : "The result; a failed test is a result, not an error"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "A field breaks a rule"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No server has the given ID"
          }
        },
        "summary" : "Tests a connection with the given values without saving them",
        "tags" : [ "Servers" ]
      }
    },
    "/api/servers/{serverId}" : {
      "delete" : {
        "operationId" : "deleteServer",
        "parameters" : [ {
          "in" : "path",
          "name" : "serverId",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Removed"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No server has this ID"
          }
        },
        "summary" : "Removes the server and everything that belongs to it",
        "tags" : [ "Servers" ]
      },
      "put" : {
        "operationId" : "updateServer",
        "parameters" : [ {
          "in" : "path",
          "name" : "serverId",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ServerRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SavedServer"
                }
              }
            },
            "description" : "Saved, also when the connection test failed"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "A field breaks a rule"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No server has this ID"
          }
        },
        "summary" : "Changes the server and tests the connection",
        "tags" : [ "Servers" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
